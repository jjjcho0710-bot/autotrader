# ──────────────────────────────────────────
# AutoTrader 환경변수 설정
# Railway Variables 탭에 그대로 붙여넣기
# ──────────────────────────────────────────

# ── PostgreSQL (Railway에서 자동 제공) ──
DB_HOST=your-postgres-host.railway.internal
DB_PORT=5432
DB_NAME=railway
DB_USER=postgres
DB_PASS=your-db-password

# ── Redis (Railway에서 자동 제공) ──
REDIS_HOST=your-redis-host.railway.internal
REDIS_PORT=6379
REDIS_PASS=your-redis-password

# ── 한국투자증권 KIS API ──
# https://apiportal.koreainvestment.com 에서 발급
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_ACCOUNT_NO=00000000-01       # 계좌번호
KIS_IS_PAPER=true                # true=모의투자, false=실거래

# ── 업비트 API ──
# https://upbit.com/service_center/open_api_info 에서 발급
UPBIT_ACCESS_KEY=your-upbit-access-key
UPBIT_SECRET_KEY=your-upbit-secret-key

# ── 텔레그램 ──
# @BotFather 에서 봇 생성 후 발급
TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ── 수집 설정 ──
COLLECT_INTERVAL_SEC=60          # 수집 주기 (초)

# ── 수집 종목 (선택 — 기본값 사용시 비워두기) ──
# STOCK_SYMBOLS=005930,000660,035420
# CRYPTO_PAIRS=KRW-BTC,KRW-ETH,KRW-SOL
